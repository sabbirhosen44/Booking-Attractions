[app]
environment = "development"

[security]
secret_key = "your-secretkey"

[development]
debug = true

[production]
debug = false

[database]
engine = "django.contrib.gis.db.backends.postgis"
name = "booking_attraction"
user = "postgres"
password = "postgres"
host = "db"
port = 5432

[import]
data_dir = "data"

[iceberg]
warehouse_dir = "spark_pipeline_data/warehouse"
catalog_name = "booking"
database = "attractions"

[elasticsearch]
host = "http://elasticsearch:9200"
index_prefix = "booking_attraction"
batch_size = 500

[dynamodb]
endpoint_url = "http://dynamodb-local:8000"
region = "us-east-1"

[vector_db]
host = "qdrant"
port = 6333
collection_name = "rental_property"
embedding_model = "all-MiniLM-L6-v2"
batch_size = 100

[duplicate_detection]
threshold = 0.95
query_batch_size = 50

[sitemap]
site_url = "https://www.rentbyowner.com"
output_dir = "sitemap_output"
gzip_output = true
batch_size = 1000
max_urls_per_file = 50000
max_file_size_mb = 50
nearby_radius_km = 5